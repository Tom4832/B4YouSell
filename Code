<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Before You Sell - Maximize Your Home's Value</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Smooth transitions for our app screens */
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Custom spinner for the AI loading screen */
        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top: 4px solid #10b981;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-2 cursor-pointer" onclick="showScreen('home-screen')">
                <span class="text-2xl font-black tracking-tight text-emerald-600">BeforeYouSell</span>
            </div>
            <button onclick="showScreen('question-screen')" class="text-sm font-bold text-emerald-600 hover:text-emerald-700 transition">
                Start Analysis →
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow flex flex-col items-center justify-center p-4">
        
        <!-- ========================================== -->
        <!-- SCREEN 1: HOME PAGE -->
        <!-- ========================================== -->
        <div id="home-screen" class="max-w-4xl w-full fade-in">
            <div class="text-center mb-12 mt-8">
                <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">AI-Powered Real Estate Tool</span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mt-6 mb-4 tracking-tight">
                    Don't list your home until you check its <span class="text-emerald-600">hidden potential</span>.
                </h1>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-8">
                    Upload a few photos. Our AI will instantly identify low-cost, high-ROI updates (like lighting and paint) and give you the exact links to buy them locally.
                </p>
                <button onclick="showScreen('question-screen')" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-lg py-4 px-10 rounded-full shadow-lg hover:shadow-xl transition transform hover:-translate-y-1">
                    Get Started for Free
                </button>
            </div>

            <!-- How It Works Examples -->
            <div class="grid md:grid-cols-3 gap-6 mt-16">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 text-center">
                    <div class="text-3xl mb-3">📸</div>
                    <h3 class="font-bold text-slate-900 mb-2">1. Snap a Photo</h3>
                    <p class="text-sm text-slate-500">Take pictures of your key rooms: kitchen, bathroom, and living areas.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 text-center">
                    <div class="text-3xl mb-3">🤖</div>
                    <h3 class="font-bold text-slate-900 mb-2">2. AI Analysis</h3>
                    <p class="text-sm text-slate-500">Our engine scans for dated fixtures, bad lighting, and unappealing colors.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 text-center">
                    <div class="text-3xl mb-3">🛒</div>
                    <h3 class="font-bold text-slate-900 mb-2">3. Shop & Upgrade</h3>
                    <p class="text-sm text-slate-500">Get a targeted shopping list with real-time links to local hardware stores.</p>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- SCREEN 2: QUESTIONNAIRE -->
        <!-- ========================================== -->
        <div id="question-screen" class="max-w-2xl w-full hidden fade-in mt-8">
            <div class="bg-white p-8 rounded-2xl shadow-md border border-slate-200">
                <h2 class="text-2xl font-bold text-slate-900 mb-6">Tell us about your property</h2>
                
                <div class="space-y-6">
                    <!-- Question 1 -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-3">What type of property are you selling?</label>
                        <div class="grid grid-cols-3 gap-3">
                            <label class="border border-slate-200 rounded-lg p-4 text-center cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition">
                                <input type="radio" name="propertyType" class="hidden">
                                <span class="block font-medium">House</span>
                            </label>
                            <label class="border border-slate-200 rounded-lg p-4 text-center cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition">
                                <input type="radio" name="propertyType" class="hidden">
                                <span class="block font-medium">Apartment</span>
                            </label>
                            <label class="border border-slate-200 rounded-lg p-4 text-center cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition">
                                <input type="radio" name="propertyType" class="hidden">
                                <span class="block font-medium">Townhouse</span>
                            </label>
                        </div>
                    </div>

                    <!-- Question 2 -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-3">What is your estimated renovation budget?</label>
                        <select class="w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                            <option>Under $500 (Cosmetic only)</option>
                            <option>$500 - $2,000 (Minor updates)</option>
                            <option>$2,000+ (Full room refreshes)</option>
                        </select>
                    </div>
                </div>

                <div class="mt-10 flex justify-between">
                    <button onclick="showScreen('home-screen')" class="text-slate-500 font-medium hover:text-slate-800">← Back</button>
                    <button onclick="showScreen('upload-screen')" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-8 rounded-lg transition">Next Step →</button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- SCREEN 3: PHOTO UPLOAD -->
        <!-- ========================================== -->
        <div id="upload-screen" class="max-w-2xl w-full hidden fade-in mt-8">
            <div class="bg-white p-8 rounded-2xl shadow-md border border-slate-200 text-center">
                <h2 class="text-2xl font-bold text-slate-900 mb-2">Upload your spaces</h2>
                <p class="text-slate-500 mb-8">Upload a wide shot of your Kitchen or Bathroom for the best results.</p>
                
                <!-- Upload Box -->
                <div class="border-2 border-dashed border-slate-300 rounded-xl p-10 bg-slate-50 hover:bg-slate-100 transition relative">
                    <input type="file" id="imageInput" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="handleFileUpload(event)">
                    <div id="upload-prompt">
                        <div class="text-4xl mb-3">📁</div>
                        <p class="font-semibold text-slate-700">Click or drag photos here</p>
                        <p class="text-xs text-slate-400 mt-1">JPEG, PNG up to 5MB</p>
                    </div>
                    <!-- Success state hidden initially -->
                    <div id="upload-success" class="hidden">
                        <div class="text-4xl mb-3">✅</div>
                        <p class="font-bold text-emerald-600">Photo successfully attached!</p>
                        <p class="text-sm text-slate-500" id="filename-display">filename.jpg</p>
                    </div>
                </div>

                <div class="mt-10 flex justify-between">
                    <button onclick="showScreen('question-screen')" class="text-slate-500 font-medium hover:text-slate-800">← Back</button>
                    <button id="analyze-btn" onclick="startAnalysis()" class="bg-slate-300 text-slate-500 font-bold py-3 px-8 rounded-lg cursor-not-allowed" disabled>Analyze Photo →</button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- SCREEN 4: LOADING / AI PROCESSING -->
        <!-- ========================================== -->
        <div id="loading-screen" class="max-w-md w-full hidden fade-in text-center mt-20">
            <div class="flex justify-center mb-6">
                <div class="spinner"></div>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-2">AI is analyzing your space...</h2>
            <ul class="text-slate-500 text-sm space-y-2 text-left max-w-xs mx-auto mt-6">
                <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Scanning for dated hardware...</span></li>
                <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Evaluating paint colors...</span></li>
                <li class="flex items-center space-x-2"><span class="text-emerald-500">✓</span> <span>Searching live inventory APIs...</span></li>
            </ul>
        </div>

        <!-- ========================================== -->
        <!-- SCREEN 5: RESULTS & PRODUCTS -->
        <!-- ========================================== -->
        <div id="results-screen" class="max-w-5xl w-full hidden fade-in mt-8">
            
            <div class="bg-emerald-600 text-white p-6 rounded-t-2xl flex flex-col md:flex-row justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold">Analysis Complete</h2>
                    <p class="text-emerald-100">Estimated value increase: <span class="font-black text-white text-xl">+$8,500</span></p>
                </div>
                <button class="mt-4 md:mt-0 bg-white text-emerald-700 font-bold py-2 px-6 rounded-lg shadow hover:bg-slate-100 transition">
                    Email me this report
                </button>
            </div>

            <div class="bg-white p-6 rounded-b-2xl shadow-lg border-x border-b border-slate-200 grid md:grid-cols-2 gap-8">
                
                <!-- Left: User's Uploaded Image -->
                <div>
                    <h3 class="font-bold text-slate-900 mb-4 uppercase tracking-wide text-sm">Your Uploaded Space</h3>
                    <div class="bg-slate-200 rounded-xl h-64 md:h-96 bg-cover bg-center shadow-inner" id="user-image-preview">
                        <!-- Image loads here via JS -->
                    </div>
                </div>

                <!-- Right: Structured Product Recommendations -->
                <div>
                    <h3 class="font-bold text-slate-900 mb-4 uppercase tracking-wide text-sm">Suggested Upgrades (High ROI)</h3>
                    
                    <div class="space-y-4">
                        <!-- Product 1 -->
                        <div class="border border-slate-200 rounded-xl p-4 flex gap-4 hover:border-emerald-400 transition bg-slate-50">
                            <div class="w-16 h-16 bg-white rounded-lg border border-slate-200 flex-shrink-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=150&q=80');"></div>
                            <div class="flex-1">
                                <h4 class="font-bold text-slate-900 text-sm">Modern Matte Black Faucet</h4>
                                <p class="text-xs text-slate-500 mb-2">Replaces dated chrome hardware. High visual impact.</p>
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-slate-800">$89.00</span>
                                    <a href="#" class="text-xs font-bold bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded hover:bg-emerald-200 transition">Buy on Home Depot →</a>
                                </div>
                            </div>
                        </div>

                        <!-- Product 2 -->
                        <div class="border border-slate-200 rounded-xl p-4 flex gap-4 hover:border-emerald-400 transition bg-slate-50">
                            <div class="w-16 h-16 bg-white rounded-lg border border-slate-200 flex-shrink-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1565814329452-e1efa11c5b89?auto=format&fit=crop&w=150&q=80');"></div>
                            <div class="flex-1">
                                <h4 class="font-bold text-slate-900 text-sm">Alabaster White Interior Paint</h4>
                                <p class="text-xs text-slate-500 mb-2">Neutralizes the room, making it appear 20% larger to buyers.</p>
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-slate-800">$45.00 / gal</span>
                                    <a href="#" class="text-xs font-bold bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded hover:bg-emerald-200 transition">Buy on Bunnings →</a>
                                </div>
                            </div>
                        </div>

                        <!-- Product 3 -->
                        <div class="border border-slate-200 rounded-xl p-4 flex gap-4 hover:border-emerald-400 transition bg-slate-50">
                            <div class="w-16 h-16 bg-white rounded-lg border border-slate-200 flex-shrink-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1513506003901-1e6a229e9d15?auto=format&fit=crop&w=150&q=80');"></div>
                            <div class="flex-1">
                                <h4 class="font-bold text-slate-900 text-sm">Brushed Brass Cabinet Pulls (10-Pk)</h4>
                                <p class="text-xs text-slate-500 mb-2">Cheap fix that modernizes older wooden cabinetry.</p>
                                <div class="flex justify-between items-center">
                                    <span class="font-black text-slate-800">$29.99</span>
                                    <a href="#" class="text-xs font-bold bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded hover:bg-emerald-200 transition">Buy on Amazon →</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            
            <div class="text-center mt-6">
                <button onclick="showScreen('home-screen')" class="text-slate-500 hover:text-emerald-600 font-medium underline">Start Over with a New Room</button>
            </div>
        </div>

    </main>

    <!-- Application Logic -->
    <script>
        // Store the user's uploaded image URL globally
        let uploadedImageUrl = '';

        // Function to switch between screens cleanly
        function showScreen(screenId) {
            // Hide all screens
            const screens = ['home-screen', 'question-screen', 'upload-screen', 'loading-screen', 'results-screen'];
            screens.forEach(id => document.getElementById(id).classList.add('hidden'));
            
            // Show requested screen
            document.getElementById(screenId).classList.remove('hidden');
            window.scrollTo(0,0);
        }

        // Handles the file upload and creates a local preview URL
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                // Update UI to show success
                document.getElementById('upload-prompt').classList.add('hidden');
                document.getElementById('upload-success').classList.remove('hidden');
                document.getElementById('filename-display').innerText = file.name;
                
                // Enable the Next Button
                const btn = document.getElementById('analyze-btn');
                btn.disabled = false;
                btn.classList.remove('bg-slate-300', 'text-slate-500', 'cursor-not-allowed');
                btn.classList.add('bg-emerald-600', 'text-white', 'hover:bg-emerald-700');

                // Create a temporary local URL for the image to show on the results page
                uploadedImageUrl = URL.createObjectURL(file);
            }
        }

        // Simulates the AI Processing delay
        function startAnalysis() {
            showScreen('loading-screen');
            
            // Wait 3.5 seconds to simulate complex AI server processing
            setTimeout(() => {
                // Inject the user's actual uploaded photo into the results screen
                if (uploadedImageUrl) {
                    document.getElementById('user-image-preview').style.backgroundImage = `url('${uploadedImageUrl}')`;
                }
                showScreen('results-screen');
            }, 3500);
        }
    </script>
</body>
</html>
